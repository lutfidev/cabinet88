<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon on API 26 and up: the wordmark's `88` in highlight yellow,
  over the app's own background gradient.

  All three layers are generated by `tool/render_store_assets.dart` from
  lib/theme/, never drawn by hand. The monochrome layer is the same letterform
  flat and unglowed, because a themed icon is recoloured by the launcher.

  Below API 26 the square PNG in each mipmap bucket is used instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
